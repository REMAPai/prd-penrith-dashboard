# Copy to .env.local (gitignored). Real values come from the secure credentials service, never chat or email.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_ENTRA_ENABLED=false
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
DATABASE_URL=
VAULT_API_BASE_URL=
VAULT_API_KEY=
VAULT_API_TOKEN=
N8N_BASE_URL=
N8N_API_KEY=
CONVERSATION_STORE_URL=
CONVERSATION_STORE_KEY=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
JIRA_BASE_URL=
JIRA_API_TOKEN=

# Optional: password for the fallback sign-in of seeded admins (leave empty to allow SSO only)
SEED_ADMIN_PASSWORD=
AUTH_ENTRA_MULTITENANT=false
AUTH_FALLBACK_ENABLED=true

# n8n posts conversation turns to /api/ingest/* with this key (min 24 chars)
INGEST_API_KEY=
# Set to true only when ClickSend sending is approved and enabled in n8n
OUTBOUND_SENDING_LIVE=

# Deprecated n8n conversation webhook fallback (passphrase travels in the URL query string, so it is off by default).
# The dashboard database written by n8n is the live feed. Set to true only to re-enable the webhook.
